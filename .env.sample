# SIG / LTIR configuration template — copy to sig/.env and edit.
# Every field of ltir/config.py::Config can be set with its UPPER_CASE name.
# Documentation: docs/README.md (reading guide; every parameter: docs/11_reference.md §11.3); contributor rules: AGENTS.md.

# --- paths -----------------------------------------------------------------
# WORKSPACE_DIR=workspace                  # relative to sig/
# MODEL_DIR=models                         # holds one folder per model, named by the last path segment of EMBEDDING_MODEL

# --- embeddings (docs/04_representation.md) -------------------------------------
# The model (and its folder's REVISION), EMBEDDING_TRUNCATE_DIM, EMBEDDING_QUERY_INSTRUCTION,
# BLOCK_WEIGHTS, EMM_COMPONENT_WEIGHT, MIN_COMPONENT_Z, MIN_EMM_SCORE and WEIGHT_EMM_REF are part
# of the representation fingerprint: changing one makes an existing workspace refuse ingest and
# queries until `python -m ltir migrate --yes` rebuilds it. EMBEDDING_DEVICE is not (the model
# runs in its checkpoint dtype on every device).
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B  # folder models/Qwen3-Embedding-0.6B (scripts/download_model.py)
EMBEDDING_TRUNCATE_DIM=384                 # Matryoshka slice, re-normalised; 0 = native width
EMBEDDING_QUERY_INSTRUCTION=Given a quantitative analysis question, retrieve relevant statistical subgroup patterns
EMBEDDING_DEVICE=cuda                      # auto | cpu | cuda | cuda:0
# EMBEDDING_BACKEND=hashing                # offline test backend (no model)
# BLOCK_WEIGHTS=0.45,0.55,1.0              # scope, target, phenomenon
# Alternative embedder (MiniLM-L12, 384-d, no instruction). Cosine thresholds are
# embedder-specific (docs/05_latent_anchors.md §5.10), so switch MIN_ASSIGN_THRESHOLD with it:
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_TRUNCATE_DIM=0
# EMBEDDING_QUERY_INSTRUCTION=
# MIN_ASSIGN_THRESHOLD=0.55
# GROUNDING_MIN_COSINE=0.50                # dense literal grounding floor measured for MiniLM (Qwen3: 0.30; docs/07 §7.1.1)

# --- Gemma 4 (docs/07_question_answering.md §7.5) — any OpenAI-compatible endpoint ---
# OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it
LLM_PROVIDER_ORDER=dekallm/bf16,parasail/bf16,nextbit/bf16   # pinned providers, no fallbacks
LLM_API_KEY=sk-or-...                      # OpenRouter key
# Local alternatives:
# LLM_BASE_URL=http://localhost:11434/v1   # Ollama
# LLM_MODEL=gemma4
# LLM_BASE_URL=http://localhost:1234/v1    # LM Studio
# LLM_MODEL=google/gemma-4-26b-a4b
# LLM_REASONING_EFFORT=none                # disable "thinking" where supported
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200

# --- optional Neo4j mirror (docs/06_graph_and_storage.md §6.6) ------------------
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=sigv1                       # simple ASCII, no underscores

# --- discovery / selection (docs/02_discovery.md, docs/03_insights.md) -----------
# BIN_COLUMNS=median_income:4,housing_median_age:4
# CATEGORICAL_COLUMNS=Store,Holiday_Flag   # number-coded columns to treat as dimensions (skipped when a dataset lacks them)
# VALIDATION_BUDGET=50
# MIN_EFFECT_Z=0.5
# MAX_P_ADJUSTED=0.05
# MIN_STABILITY=0.5
# MIN_EMM_SCORE=0.08   # RMS correlation change per metric pair (after reliability shrinkage)
# REDUNDANCY_JACCARD=0.88  # near-duplicate cohorts pruned before validation (same metric and sign)

# --- latent ontology (docs/05_latent_anchors.md) — lac names, SIG-sized defaults --
# CONCEPTS_PER_CHUNK=1
# DICTIONARY_K_MIN=4
# DICTIONARY_K_STEP=2
# MIN_ASSIGN_THRESHOLD=0.75   # Qwen3; 0.55 for MiniLM (docs/05_latent_anchors.md §5.10)
# MAX_ASSIGN_THRESHOLD=0.80
# SOFT_MERGE_LOW=0.85
# RELATED_TO_PEER_COUNT=3
# RELATED_TO_MIN_WEIGHT=0.30
# CENTROID_ALPHA=0.05
# guards: hub threshold max(DENSITY_FLOOR, DENSITY_MULTIPLE / attractors), EMA damping, per-batch trust region
# DENSITY_FLOOR=0.25
# DENSITY_MULTIPLE=3.0
# MAX_CENTROID_STEP=0.10
# advisory warnings
# WARN_ORPHAN_RATE=0.50
# WARN_MIN_EXTRACTION_YIELD=0.10
# WARN_AVG_DEGREE=1.0,8.0

# --- traversal (docs/07_question_answering.md §7.3) ------------------------------
# MAX_LATENT_HOPS=1
# TRAVERSAL_MAX_DEPTH=5

# --- web ---------------------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8765
SPHERE_EXPORT=true                         # write workspace/graph/sphere.html in the background after each READY batch
