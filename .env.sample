# SIG configuration template — copy to .env and edit. compose.yaml passes .env to the services; host runs read it too.
# Every setting is a field of a package config (subgroup_miner, attractor_topology, graph_query_engine) or of the
# service settings, set with its UPPER_CASE name. Documentation: docs/README.md (every parameter: docs/11_reference.md §11.3).

# --- paths -----------------------------------------------------------------
# WORKSPACE_DIR=workspace                  # relative paths resolve against the repository root
# MODEL_DIR=models                         # holds Qwen3-Embedding-0.6B/ (python -m insight_graph_service.core.model_store)

# --- embeddings (docs/04_representation.md) -------------------------------------
# The embedder is Qwen3-Embedding-0.6B at a pinned revision (384-d Matryoshka slices, 1152-d insight vectors).
# BLOCK_WEIGHTS, EMM_COMPONENT_WEIGHT, MIN_COMPONENT_Z, MIN_EMM_SCORE and WEIGHT_EMM_REF are part of the
# representation fingerprint: changing one makes an existing workspace refuse ingest and questions until it is
# reset (POST /api/reset). EMBEDDING_DEVICE is not (the model runs in its checkpoint dtype on every device).
EMBEDDING_DEVICE=auto                      # auto | cpu | cuda | cuda:0 (the containers use cpu)
# BLOCK_WEIGHTS=0.45,0.55,1.0              # scope, target, phenomenon

# --- LLM (docs/07_question_answering.md §7.5, docs/12_architecture.md) ------------------
# Answers reach the LLM only through the LLM model broker, which holds the upstream, the model, its key and the
# provider order (the GEMMA_* block below).
# LLM_BASE_URL=http://127.0.0.1:8080/v1     # the broker (default)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200

# --- LLM model broker (llm_model_broker/) ---------------------------------------
# Only the broker reads these; the other services never receive the key.
GEMMA_BASE_URL=https://openrouter.ai/api/v1
GEMMA_CHAT_ENDPOINT=/chat/completions
GEMMA_MODEL_NAME=google/gemma-4-26b-a4b-it
GEMMA_PROVIDER=dekallm/bf16,parasail/bf16,nextbit/bf16   # pinned providers, tried in order, no fallbacks
GEMMA_API_KEY=sk-or-...
# Local alternatives (from inside a container the host is host.docker.internal):
# GEMMA_BASE_URL=http://host.docker.internal:11434/v1      # Ollama
# GEMMA_MODEL_NAME=gemma4
# GEMMA_PROVIDER=
# GEMMA_API_KEY=
GEMMA_CONNECT_TIMEOUT_SEC=5
GEMMA_READ_TIMEOUT_SEC=120

# --- optional Neo4j mirror (docs/06_graph_and_storage.md §6.6) ------------------
# Host runs only; the compose stack sets its own Neo4j address and password (SIG_NEO4J_PASSWORD).
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=sigv1                       # simple ASCII, no underscores

# --- discovery and validity (docs/02_discovery.md, docs/03_insights.md) -----------
# BIN_COLUMNS=median_income:4,housing_median_age:4
# CATEGORICAL_COLUMNS=Store,Holiday_Flag   # number-coded columns to treat as dimensions (skipped when a dataset lacks them)
# VALIDATION_BUDGET=50
# MIN_EFFECT_Z=0.5
# MAX_P_ADJUSTED=0.05
# MIN_STABILITY=0.5
# MIN_EMM_SCORE=0.08   # RMS correlation change per metric pair (after reliability shrinkage)
# REDUNDANCY_JACCARD=0.88  # near-duplicate cohorts pruned before validation (same metric and sign)

# --- admission into the graph (docs/03_insights.md §3.2) --------------------------
# MIN_INSIGHT_WEIGHT=0.2
# MAX_INSIGHTS_PER_BATCH=200
# MAX_UPLOAD_MB=200

# --- attractor topology (docs/05_latent_anchors.md) — lac names, SIG-sized defaults --
# CONCEPTS_PER_CHUNK=1   # one atom per insight at extraction; the second membership comes from the assignment rule
# TOP_K_ASSIGN=2
# MIXTURE_RATIO=0.80      # also the co-membership rule of the snapshot (docs/05_latent_anchors.md §5.7)
# DICTIONARY_K_MIN=4
# DICTIONARY_K_STEP=2
# MIN_ASSIGN_THRESHOLD=0.75   # cosine thresholds are calibrated for Qwen3 (docs/05_latent_anchors.md §5.10)
# MAX_ASSIGN_THRESHOLD=0.80
# SOFT_MERGE_LOW=0.85
# RELATED_TO_PEER_COUNT=3
# RELATED_TO_MIN_WEIGHT=0.30
# CENTROID_ALPHA=0.05
# guards: hub threshold max(DENSITY_FLOOR, DENSITY_MULTIPLE / attractors), EMA damping, per-batch trust region
# DENSITY_FLOOR=0.25
# DENSITY_MULTIPLE=3.0
# MAX_CENTROID_STEP=0.10
# advisory warnings
# WARN_ORPHAN_RATE=0.50
# WARN_MIN_EXTRACTION_YIELD=0.10
# WARN_AVG_DEGREE=1.0,8.0

# --- grounding and traversal (docs/07_question_answering.md) ----------------------
# GROUNDING_MIN_COSINE=0.30   # dense literal grounding floor (Qwen3)
# MAX_LATENT_HOPS=1
# TRAVERSAL_MAX_DEPTH=5

# --- web (host runs) ----------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8765
