# Secrets
.env
.env.*
!.env.sample

# Runtime / local workspaces
workspace/
workspace.bak-*/
workspace.migrating/
workspace.deleting-*/
*.writer.lock
.scratch*/
review-reports/
# a host's own compose settings, e.g. a copy of compose.gpu.yaml
compose.override.yaml

# keep dirs, drop contents
models/**
!models/.gitkeep
data/**
!data/.gitkeep
# the shipped datasets the console offers (scripts/demo_datasets.py builds them; data/demo/SOURCES.md their licences)
!data/demo/
!data/demo/*

# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_tmp*/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
