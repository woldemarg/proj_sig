# Copy to .env in this folder. SIG is this repo (../compose.yaml); only the ADS repo needs a path.
# The demo copies nothing: compose.yaml includes their own compose files and builds their images there.

# The agentic-data-science repo (its .env and copilot.env hold the LLM settings). A relative path counts from this folder.
ADS_DIR=

# The SIG graph service on an NVIDIA GPU; without one, set compose.yaml (the CPU image)
SIG_GPU_FILE=compose.gpu.yaml

# The demo page
DEMO_PORT=8090
