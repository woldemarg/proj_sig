# LLM gateway settings (llm_gateway/, docs/12_architecture.md §12.4) — copy to .env.gemma and edit.
# compose.yaml passes this file to the `llm` service; `python -m llm_gateway` reads it on the host.

# OpenRouter
GEMMA_BASE_URL=https://openrouter.ai/api/v1
GEMMA_CHAT_ENDPOINT=/chat/completions
GEMMA_MODEL_NAME=google/gemma-4-26b-a4b-it
GEMMA_PROVIDER=dekallm/bf16,parasail/bf16,nextbit/bf16   # pinned providers, tried in order, no fallbacks
GEMMA_API_KEY=sk-or-...
# Local alternatives (from inside a container the host is host.docker.internal):
# GEMMA_BASE_URL=http://host.docker.internal:11434/v1      # Ollama
# GEMMA_MODEL_NAME=gemma4
# GEMMA_PROVIDER=
# GEMMA_API_KEY=
GEMMA_CONNECT_TIMEOUT_SEC=5
GEMMA_READ_TIMEOUT_SEC=120
